---
import { Icon } from "astro-icon/components";

interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section id="contact" class="min-h-[80vh] py-12 md:py-20 flex flex-col justify-center gap-10">
  <div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tight mb-3">
      {t.contact.title}
    </h2>
    <p class="text-base sm:text-lg text-muted max-w-2xl leading-relaxed">
      {t.contact.description}
    </p>
  </div>

  <div class="max-w-3xl mx-auto w-full">
    <!-- Contact Form (Terminal OS Theme) -->
    <div class="flex flex-col rounded-xl overflow-hidden bg-surface border border-border/80 shadow-lg sidebar-glow group">
      <!-- Terminal Header -->
      <div class="flex items-center justify-between px-6 py-3 border-b border-border/40 bg-bg/30">
        <div class="flex items-center gap-2">
          <Icon name="lucide:terminal" class="w-4 h-4 text-muted" />
          <span class="text-[0.7rem] font-mono text-muted uppercase tracking-wider">mail_client_env</span>
        </div>
        <!-- Controles eliminados a petición del usuario -->
      </div>

      <!-- Terminal Body -->
      <div class="p-6 sm:p-8 font-mono flex-1 flex flex-col">
        <!-- Command line prompt -->
        <div class="flex items-center text-sm md:text-base mb-6 opacity-90 whitespace-nowrap overflow-x-auto no-scrollbar">
          <span class="text-accent font-bold">~</span>
          <span class="text-text mx-2">❯</span>
          <span class="text-muted-custom font-medium">./send_message.sh <span class="text-text font-bold">--to</span> pedro.marquez</span>
          <span class="w-2 h-4 bg-accent/70 ml-2 animate-pulse shrink-0"></span>
        </div>

        <!-- Form via Web3Forms -->
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-5 text-sm">
          <!-- Replace with your actual Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="54b9fc90-5dee-44f9-9f08-13a96e17f542" />
          
          <div class="flex flex-col gap-1.5">
            <label for="name" class="text-dim uppercase tracking-wider text-[0.65rem]">{t.contact.form.nameLabel}</label>
            <div class="relative flex items-center">
              <span class="absolute left-3 text-muted">$&gt;</span>
              <input 
                type="text" 
                name="name" 
                id="name"
                required
                placeholder={t.contact.form.namePlaceholder}
                class="w-full bg-bg/50 border border-border/60 rounded-lg py-2.5 pl-8 pr-4 text-text placeholder:text-muted/50 focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/50 transition-all"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-dim uppercase tracking-wider text-[0.65rem]">{t.contact.form.emailLabel}</label>
            <div class="relative flex items-center">
              <span class="absolute left-3 text-muted">$&gt;</span>
              <input 
                type="email" 
                name="email" 
                id="email"
                required
                placeholder={t.contact.form.emailPlaceholder}
                class="w-full bg-bg/50 border border-border/60 rounded-lg py-2.5 pl-8 pr-4 text-text placeholder:text-muted/50 focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/50 transition-all"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-dim uppercase tracking-wider text-[0.65rem]">{t.contact.form.messageLabel}</label>
            <textarea 
              name="message" 
              id="message"
              required
              rows="4"
              placeholder={t.contact.form.messagePlaceholder}
              class="w-full bg-bg/50 border border-border/60 rounded-lg py-3 px-4 text-text placeholder:text-muted/50 focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/50 transition-all resize-none"
            ></textarea>
          </div>

          <!-- Honeypot -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

          <div class="mt-2 flex justify-end">
            <button 
              type="submit"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent/10 border border-accent/20 text-accent font-bold tracking-wider hover:bg-accent/20 hover:border-accent/40 transition-all active:scale-95"
            >
              <span class="text-xs">[</span>
              {t.contact.form.submitButton}
              <span class="text-xs">]</span>
            </button>
          </div>
        </form>

        <!-- Form status indicator -->
        <div 
          id="form-status" 
          class="hidden mt-4 p-3 rounded-lg border font-mono text-xs items-center gap-2"
          data-sending={t.contact.form.sending}
          data-success={t.contact.form.success}
          data-error={t.contact.form.error}
        >
          <span id="form-status-badge"></span>
          <span id="form-status-text"></span>
        </div>

        <!-- Direct Email Fallback (Anti-spam obscured) -->
        <div class="mt-8 pt-6 border-t border-border/20 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-dim uppercase tracking-wider">
            ¿O prefieres correo directo?
          </p>
          <a 
            href={t.contact.links.emailUrl}
            class="group flex items-center gap-2 px-4 py-2 rounded-lg bg-bg/50 border border-border/60 text-xs text-muted hover:text-text hover:border-accent/40 transition-colors"
          >
            <Icon name="lucide:mail" class="w-4 h-4 text-accent group-hover:-translate-y-0.5 transition-transform" />
            <span class="font-mono tracking-wide">pedro.marquez.quiroz <span class="text-accent">[at]</span> gmail.com</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function setupForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const statusDiv = document.getElementById('form-status');
    const statusBadge = document.getElementById('form-status-badge');
    const statusText = document.getElementById('form-status-text');

    if (!form || !statusDiv || !statusBadge || !statusText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const txtSending = statusDiv.getAttribute('data-sending') || 'Sending...';
      const txtSuccess = statusDiv.getAttribute('data-success') || 'Message sent!';
      const txtError = statusDiv.getAttribute('data-error') || 'Error sending message.';

      // Reset styles and show sending state
      statusDiv.classList.remove('hidden');
      statusDiv.classList.add('flex');
      statusDiv.className = "mt-4 p-3 rounded-lg border font-mono text-xs flex items-center gap-2 bg-accent/5 border-accent/20 text-accent";
      statusBadge.className = "font-bold text-accent animate-pulse";
      statusBadge.textContent = "[ RUNNING ]";
      statusText.textContent = txtSending;

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: json
        });

        if (response.status === 200) {
          statusDiv.className = "mt-4 p-3 rounded-lg border font-mono text-xs flex items-center gap-2 bg-green-500/5 border-green-500/20 text-green-500";
          statusBadge.className = "font-bold text-green-500";
          statusBadge.textContent = "[   OK   ]";
          statusText.textContent = txtSuccess;
          form.reset();
        } else {
          statusDiv.className = "mt-4 p-3 rounded-lg border font-mono text-xs flex items-center gap-2 bg-red-500/5 border-red-500/20 text-red-500";
          statusBadge.className = "font-bold text-red-500";
          statusBadge.textContent = "[ FAILED ]";
          statusText.textContent = txtError;
        }
      } catch (error) {
        statusDiv.className = "mt-4 p-3 rounded-lg border font-mono text-xs flex items-center gap-2 bg-red-500/5 border-red-500/20 text-red-500";
        statusBadge.className = "font-bold text-red-500";
        statusBadge.textContent = "[ FAILED ]";
        statusText.textContent = txtError;
      }
    });
  }

  // Run on initial load
  setupForm();
  // Run after Astro swap (for view transitions navigation)
  document.addEventListener('astro:after-swap', setupForm);
</script>
