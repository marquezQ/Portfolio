---
import { Icon } from 'astro-icon/components';

interface Props {
  projectImagesMap: Record<string, string[]>;
}

const { projectImagesMap } = Astro.props;
---

<!-- MODAL DE GALERÍA — Hybrid OS Lightbox -->
<dialog id="gallery-modal" class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm border-none">
  
  <!-- Contenedor: OS Window centrada con respiro en pantallas grandes -->
  <div class="w-full h-full flex items-center justify-center p-0 md:p-6 lg:p-10">
    <div class="w-full h-full md:max-w-6xl md:h-[90vh] flex flex-col bg-bg border border-border/70 md:rounded-xl shadow-2xl overflow-hidden min-h-0">

      <!-- ══ HEADER OS-style compacto ══ -->
      <div class="flex items-center justify-between px-4 py-2.5 bg-surface border-b border-border/60 shrink-0">
        <div class="flex items-center gap-2.5 min-w-0">
          <Icon name="lucide:terminal" class="w-3.5 h-3.5 text-accent shrink-0" />
          <span class="font-mono text-[0.65rem] text-muted uppercase tracking-wider">sys.gallery</span>
          <span class="text-border/60 font-mono text-[0.65rem]">→</span>
          <span id="modal-title" class="font-mono text-[0.65rem] text-accent truncate"></span>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <!-- Contador -->
          <span id="image-counter" class="font-mono text-[0.6rem] text-muted border border-border/50 px-2 py-0.5 rounded bg-bg">[1/1]</span>
          <!-- Close button -->
          <button
            id="close-modal"
            class="p-1.5 rounded-md hover:bg-hover text-muted hover:text-text transition-colors active:scale-95"
            aria-label="Close gallery"
          >
            <Icon name="lucide:x" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <!-- ══ ZONA DE IMAGEN (ocupa todo el espacio restante) ══ -->
      <div class="flex-1 bg-bg flex items-center justify-center relative min-h-0 group/image">
        
        <!-- Imagen Principal -->
        <img
          id="modal-image"
          src=""
          alt="Gallery preview"
          class="w-full h-full object-contain transition-opacity duration-200"
        />

        <!-- Prev Arrow — visible en hover, siempre accesible -->
        <button
          id="gallery-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 z-20
                 flex items-center justify-center
                 w-9 h-9 rounded-lg
                 bg-surface/80 backdrop-blur-sm border border-border/60
                 text-text opacity-0 group-hover/image:opacity-100
                 hover:border-accent/50 hover:text-accent
                 transition-all duration-200 active:scale-95 shadow-lg"
          aria-label="Previous image"
        >
          <Icon name="lucide:chevron-left" class="w-5 h-5" />
        </button>

        <!-- Next Arrow -->
        <button
          id="gallery-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 z-20
                 flex items-center justify-center
                 w-9 h-9 rounded-lg
                 bg-surface/80 backdrop-blur-sm border border-border/60
                 text-text opacity-0 group-hover/image:opacity-100
                 hover:border-accent/50 hover:text-accent
                 transition-all duration-200 active:scale-95 shadow-lg"
          aria-label="Next image"
        >
          <Icon name="lucide:chevron-right" class="w-5 h-5" />
        </button>

        <!-- Mobile tap zones (izquierda y derecha invisible, para touch) -->
        <div id="tap-prev" class="absolute left-0 top-0 h-full w-1/3 z-10 md:hidden cursor-pointer"></div>
        <div id="tap-next" class="absolute right-0 top-0 h-full w-1/3 z-10 md:hidden cursor-pointer"></div>
      </div>

      <!-- ══ FOOTER: Dot Indicators ══ -->
      <div class="shrink-0 flex items-center justify-center gap-2 py-3 px-4 bg-surface border-t border-border/40">
        <div id="gallery-dots" class="flex items-center gap-2">
          <!-- Los dots se generan dinámicamente -->
        </div>
      </div>

    </div>
  </div>
</dialog>

<script define:vars={{ projectImagesMap }}>
  function initGallery() {
    const modal     = document.getElementById('gallery-modal');
    const closeBtn  = document.getElementById('close-modal');
    const modalImg  = document.getElementById('modal-image');
    const prevBtn   = document.getElementById('gallery-prev');
    const nextBtn   = document.getElementById('gallery-next');
    const tapPrev   = document.getElementById('tap-prev');
    const tapNext   = document.getElementById('tap-next');
    const dotsEl    = document.getElementById('gallery-dots');
    const counterEl = document.getElementById('image-counter');
    const titleEl   = document.getElementById('modal-title');
    const galleryBtns = document.querySelectorAll('[data-gallery]');

    if (!modal || !closeBtn || !modalImg) return;

    let currentProjectId = null;
    let currentIndex     = 0;

    // ─── Render image con fade ───────────────────────────────────
    function renderImage(index) {
      modalImg.style.opacity = '0';
      setTimeout(() => {
        modalImg.src = projectImagesMap[currentProjectId][index];
        modalImg.onload = () => { modalImg.style.opacity = '1'; };
      }, 120);

      // Update counter
      const total = projectImagesMap[currentProjectId].length;
      if (counterEl) counterEl.textContent = `[${index + 1}/${total}]`;

      // Update dots
      if (dotsEl) {
        dotsEl.querySelectorAll('.gallery-dot').forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('bg-accent', 'w-5', 'rounded-sm');
            dot.classList.remove('bg-muted/40', 'w-2', 'rounded-full');
          } else {
            dot.classList.add('bg-muted/40', 'w-2', 'rounded-full');
            dot.classList.remove('bg-accent', 'w-5', 'rounded-sm');
          }
        });
      }
    }

    // ─── Renderizar dots ─────────────────────────────────────────
    function renderDots(images) {
      if (!dotsEl) return;
      dotsEl.innerHTML = '';
      images.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = `gallery-dot h-2 transition-all duration-300 cursor-pointer ${
          i === 0
            ? 'w-5 bg-accent rounded-sm'
            : 'w-2 bg-muted/40 rounded-full hover:bg-muted'
        }`;
        dot.setAttribute('aria-label', `Go to image ${i + 1}`);
        dot.onclick = () => { currentIndex = i; renderImage(i); };
        dotsEl.appendChild(dot);
      });
    }

    // ─── Setup del contenido del modal ───────────────────────────
    function setupModalContent(projectId) {
      currentProjectId = projectId;
      currentIndex = 0;

      const images = projectImagesMap[projectId];
      if (!images || images.length === 0) return;

      // Titulo
      if (titleEl) titleEl.textContent = projectId;

      // Imagen inicial (sin fade — se muestra al abrir)
      modalImg.src = images[0];
      modalImg.style.opacity = '1';

      // Counter inicial
      if (counterEl) counterEl.textContent = `[1/${images.length}]`;

      // Dots
      renderDots(images);

      // Ocultar flechas si hay una sola imagen
      const showArrows = images.length > 1;
      if (prevBtn) prevBtn.style.display = showArrows ? '' : 'none';
      if (nextBtn) nextBtn.style.display = showArrows ? '' : 'none';
    }

    // ─── Cerrar modal ─────────────────────────────────────────────
    const closeModal = () => {
      const coverImg = document.getElementById(`cover-${currentProjectId}`);

      const executeClose = () => {
        modal.close();
        modalImg.style.viewTransitionName = 'none';
        if (coverImg) coverImg.style.viewTransitionName = 'none';
      };

      if (document.startViewTransition && coverImg) {
        modalImg.style.viewTransitionName = 'gallery-morph';
        coverImg.style.viewTransitionName = 'none';
        const t = document.startViewTransition(() => {
          modal.close();
          modalImg.style.viewTransitionName = 'none';
          coverImg.style.viewTransitionName = 'gallery-morph';
        });
        t.finished.then(() => {
          coverImg.style.viewTransitionName = 'none';
        });
      } else {
        executeClose();
      }
    };

    // ─── Navegación ──────────────────────────────────────────────
    const handlePrev = () => {
      if (!currentProjectId) return;
      const len = projectImagesMap[currentProjectId].length;
      currentIndex = (currentIndex > 0) ? currentIndex - 1 : len - 1;
      renderImage(currentIndex);
    };

    const handleNext = () => {
      if (!currentProjectId) return;
      const len = projectImagesMap[currentProjectId].length;
      currentIndex = (currentIndex < len - 1) ? currentIndex + 1 : 0;
      renderImage(currentIndex);
    };

    if (prevBtn)  prevBtn.addEventListener('click', handlePrev);
    if (nextBtn)  nextBtn.addEventListener('click', handleNext);
    if (tapPrev)  tapPrev.addEventListener('click', handlePrev);
    if (tapNext)  tapNext.addEventListener('click', handleNext);

    // Keyboard navigation
    const onKeydown = (e) => {
      if (!modal.open) return;
      if (e.key === 'ArrowLeft')  handlePrev();
      if (e.key === 'ArrowRight') handleNext();
      if (e.key === 'Escape')     closeModal();
    };
    document.addEventListener('keydown', onKeydown);

    // ─── Abrir modal ─────────────────────────────────────────────
    galleryBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const projectId = e.currentTarget.dataset.gallery;
        if (!projectImagesMap[projectId]?.length) return;

        const coverImg = document.getElementById(`cover-${projectId}`);

        const executeOpen = () => {
          if (coverImg) coverImg.style.viewTransitionName = 'none';
          modalImg.style.viewTransitionName = 'gallery-morph';
          setupModalContent(projectId);
          modal.showModal();
        };

        if (document.startViewTransition && coverImg) {
          coverImg.style.viewTransitionName = 'gallery-morph';
          modalImg.style.viewTransitionName = 'none';
          const t = document.startViewTransition(() => executeOpen());
          t.finished.then(() => { modalImg.style.viewTransitionName = 'none'; });
        } else {
          executeOpen();
        }
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
