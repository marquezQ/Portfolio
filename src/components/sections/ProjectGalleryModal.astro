---
import { Icon } from 'astro-icon/components';

interface Props {
  projectImagesMap: Record<string, string[]>;
}

const { projectImagesMap } = Astro.props;
---

<!-- MODAL DE GALERÍA (Estructura base) -->
<dialog id="gallery-modal" class="bg-transparent m-0 w-full max-w-none h-full max-h-none backdrop:bg-black/90 p-4 sm:p-8">
  <div class="w-full max-w-7xl mx-auto h-full flex flex-col relative bg-surface border border-border/50 rounded-2xl shadow-2xl overflow-hidden">
    
    <!-- Modal Header OS Style -->
    <div class="flex items-center justify-between px-6 py-4 bg-bg border-b border-border/50 shrink-0">
      <div class="flex items-center gap-2">
        <Icon name="lucide:layout" class="w-4 h-4 text-muted" />
        <span id="modal-title" class="font-mono text-xs text-muted uppercase tracking-wider">Gallery View</span>
      </div>
      <button id="close-modal" class="p-2 rounded-lg hover:bg-hover text-muted hover:text-text transition-colors">
        <Icon name="lucide:x" class="w-5 h-5" />
      </button>
    </div>

    <!-- Modal Content (Carousel) -->
    <div class="flex-1 p-4 md:p-8 flex items-center justify-center bg-bg/50 relative">
      <button id="gallery-prev" class="absolute left-4 p-3 rounded-full bg-surface border border-border hover:border-accent/50 text-text transition-colors z-10 shadow-lg hidden md:block">
        <Icon name="lucide:chevron-left" class="w-6 h-6" />
      </button>
      
      <div class="w-full h-full rounded-lg overflow-hidden border border-border bg-bg flex items-center justify-center shadow-inner relative">
         <!-- Imagen a pantalla completa (Animada con opacidad) -->
         <img id="modal-image" src="" alt="Gallery" class="w-full h-full object-contain transition-opacity duration-200" />
      </div>

      <button id="gallery-next" class="absolute right-4 p-3 rounded-full bg-surface border border-border hover:border-accent/50 text-text transition-colors z-10 shadow-lg hidden md:block">
        <Icon name="lucide:chevron-right" class="w-6 h-6" />
      </button>
    </div>

    <!-- Thumbnail bar -->
    <div id="gallery-thumbnails" class="h-28 bg-bg border-t border-border/50 p-4 flex items-center justify-center gap-4 shrink-0 overflow-x-auto">
      <!-- Las miniaturas se generarán dinámicamente aquí vía JS -->
    </div>
  </div>
</dialog>

<script define:vars={{ projectImagesMap }}>
  function initGallery() {
    const modal = document.getElementById('gallery-modal');
    const closeBtn = document.getElementById('close-modal');
    const modalImage = document.getElementById('modal-image');
    const galleryButtons = document.querySelectorAll('[data-gallery]');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const thumbnailContainer = document.getElementById('gallery-thumbnails');
    
    let currentProjectId = null;
    let currentIndex = 0;

    if (!modal || !closeBtn || !modalImage) return;

    function renderImage(index) {
       modalImage.style.opacity = '0';
       setTimeout(() => {
         modalImage.src = projectImagesMap[currentProjectId][index];
         modalImage.onload = () => {
           modalImage.style.opacity = '1';
         };
       }, 150); // Pequeño delay para el efecto fade
       
       // Actualizar estado de las miniaturas
       document.querySelectorAll('.gallery-thumb').forEach((thumb, i) => {
         if (i === index) {
           thumb.classList.add('border-accent', 'opacity-100');
           thumb.classList.remove('border-border/50', 'opacity-50');
         } else {
           thumb.classList.remove('border-accent', 'opacity-100');
           thumb.classList.add('border-border/50', 'opacity-50');
         }
       });
    }

    // Abrir modal con View Transitions
    galleryButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        currentProjectId = target.dataset.gallery;
        currentIndex = 0;
        
        // Si no hay imágenes para este proyecto, ignorar
        if (!projectImagesMap[currentProjectId] || projectImagesMap[currentProjectId].length === 0) return;
        
        const coverImg = document.getElementById(`cover-${currentProjectId}`);

        const setupModalContent = () => {
           modalImage.src = projectImagesMap[currentProjectId][0];
           
           // Renderizar miniaturas
           if(thumbnailContainer) {
              thumbnailContainer.innerHTML = '';
              projectImagesMap[currentProjectId].forEach((src, i) => {
                 const thumb = document.createElement('img');
                 thumb.src = src;
                 thumb.className = `gallery-thumb min-w-[80px] sm:min-w-[120px] w-20 sm:w-32 h-full object-cover rounded-lg cursor-pointer transition-all border-2 ${i === 0 ? 'border-accent opacity-100' : 'border-border/50 opacity-50 hover:opacity-100'}`;
                 thumb.onclick = () => { currentIndex = i; renderImage(currentIndex); };
                 thumbnailContainer.appendChild(thumb);
              });
           }
        };

        const executeOpen = () => {
           if (coverImg) coverImg.style.viewTransitionName = 'none';
           modalImage.style.viewTransitionName = 'gallery-morph';
           setupModalContent();
           modal.showModal();
           document.body.style.overflow = 'hidden';
        };

        if (document.startViewTransition && coverImg) {
          // 1. Preparar el estado inicial
          coverImg.style.viewTransitionName = 'gallery-morph';
          modalImage.style.viewTransitionName = 'none';
          
          // 2. Iniciar la transición
          const transition = document.startViewTransition(() => executeOpen());
          
          // 3. IMPORTANTÍSIMO: Limpiar estado al terminar para evitar bugs
          transition.finished.then(() => {
             modalImage.style.viewTransitionName = 'none';
          });
        } else {
          setupModalContent();
          modal.showModal();
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Cerrar modal
    const closeModal = () => {
      const coverImg = document.getElementById(`cover-${currentProjectId}`);
      
      const executeClose = () => {
         modal.close();
         document.body.style.overflow = '';
         modalImage.style.viewTransitionName = 'none';
         if (coverImg) coverImg.style.viewTransitionName = 'none';
      };
      
      if (document.startViewTransition && coverImg) {
         // Preparar estado inicial para cierre
         modalImage.style.viewTransitionName = 'gallery-morph';
         if (coverImg) coverImg.style.viewTransitionName = 'none';
         
         const transition = document.startViewTransition(() => {
            modal.close();
            document.body.style.overflow = '';
            modalImage.style.viewTransitionName = 'none';
            if (coverImg) coverImg.style.viewTransitionName = 'gallery-morph';
         });
         
         // Limpiar nombres al terminar
         transition.finished.then(() => {
            if (coverImg) coverImg.style.viewTransitionName = 'none';
         });
      } else {
         executeClose();
      }
    };

    closeBtn.addEventListener('click', closeModal);
    
    // Controles de Carrusel
    if(prevBtn) {
      prevBtn.addEventListener('click', () => {
         if(currentProjectId && projectImagesMap[currentProjectId]) {
            currentIndex = (currentIndex > 0) ? currentIndex - 1 : projectImagesMap[currentProjectId].length - 1;
            renderImage(currentIndex);
         }
      });
    }
    if(nextBtn) {
      nextBtn.addEventListener('click', () => {
         if(currentProjectId && projectImagesMap[currentProjectId]) {
            currentIndex = (currentIndex < projectImagesMap[currentProjectId].length - 1) ? currentIndex + 1 : 0;
            renderImage(currentIndex);
         }
      });
    }

    // Cerrar haciendo click en el backdrop
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
