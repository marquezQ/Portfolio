---
import { getImage } from 'astro:assets';
import ProjectCard from './ProjectCard.astro';
import ProjectGalleryModal from './ProjectGalleryModal.astro';

interface Props {
  t: any;
}

const { t } = Astro.props;

type Optimized = { path: string; src: string };

const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*/*.{jpeg,jpg,png,gif}', { eager: true });

const projectFolders: Record<string, string> = {
  fastcashier: 'FastCashier',
  carpinpro: 'CarpinPro'
};

// `import.meta.glob` no garantiza orden, así que ordenamos por ruta origen:
// sin esto la galería cambiaría de orden entre builds.
const paths = Object.keys(allImages).sort();

// Optimizamos en paralelo (Promise.all) en vez de en serie.
const optimized: Optimized[] = await Promise.all(
  paths.map(async (path) => ({
    path,
    src: (await getImage({ src: allImages[path].default, format: 'webp' })).src
  }))
);

const projectImagesMap: Record<string, string[]> = Object.fromEntries(
  Object.keys(projectFolders).map((id) => [
    id,
    optimized
      .filter(({ path }) => path.includes(`/${projectFolders[id]}/`))
      .sort((a, b) => a.path.localeCompare(b.path))
      .map(({ src }) => src)
  ])
);
---

<section id="projects" class="py-12 md:py-20 flex flex-col gap-10">
  <div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tight mb-3">
      {t.projects?.title || "Projects"}
    </h2>
  </div>

  <div class="flex flex-col gap-12 @container">
    {t.projects?.items.map((project: any) => (
      <ProjectCard project={project} projectImagesMap={projectImagesMap} />
    ))}
  </div>

  <ProjectGalleryModal projectImagesMap={projectImagesMap} />
</section>
