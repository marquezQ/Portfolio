---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section id="about" class="min-h-[70vh] py-12 md:py-20 flex flex-col justify-center">
  <h2 class="text-4xl font-bold text-text tracking-tight">{t.nav.about}</h2>
  <p class="mt-6 text-base text-muted leading-relaxed max-w-2xl">
    {t.hero.bio}
  </p>
</section>
