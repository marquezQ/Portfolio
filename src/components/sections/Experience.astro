---
import { Icon } from 'astro-icon/components';

interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;

// Diccionario para asignar un icono específico basado en el ID de la experiencia
const getIconForRole = (id: string) => {
  const iconMap: Record<string, string> = {
    'admin-lab': 'lucide:server',
    'auxiliar-lab': 'lucide:monitor-dot',
    'frontend-ez': 'lucide:code',
    'pasante-dtic': 'lucide:terminal-square',
  };
  return iconMap[id] || 'lucide:briefcase';
};
---

<section id="experience" class="py-12 md:py-20 flex flex-col gap-10">
  <div>
    <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tight mb-3">
      {t.experience.title || "Experience"}
    </h2>
  </div>

  <div class="relative pl-4 sm:pl-6 md:pl-8">
    <!-- Línea de trazado (System Trace) -->
    <div class="absolute top-0 bottom-0 left-1.75 sm:left-2.75 md:left-3.75 w-0.5 bg-border/50"></div>

    <div class="flex flex-col gap-6">
      {t.experience.items.map((item: any) => (
        <div class="relative pl-8 sm:pl-10 group">
          
          <!-- Nodo (Git Commit Dot) -->
          <div class="absolute -left-1.25 sm:-left-px md:left-0.75 top-4 w-6 h-6 rounded-full bg-surface border-2 border-border/80 flex items-center justify-center group-hover:border-accent group-hover:shadow-[0_0_10px_var(--c-accent)] transition-all duration-300 z-10">
            <div class="w-2 h-2 rounded-full bg-border group-hover:bg-accent transition-colors duration-300"></div>
          </div>

          <!-- Contenido de la Tarjeta Compacta (System Log Style) -->
          <div class="bg-surface border border-border/50 rounded-xl p-4 md:p-5 shadow-sm hover:border-border/80 transition-colors group-hover:shadow-md">
            
            <!-- Cabecera Compacta: Rol y Fecha -->
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
              <div>
                <h3 class="text-lg font-bold text-text group-hover:text-accent transition-colors leading-tight">
                  {item.role}
                </h3>
                <div class="flex items-center gap-1.5 text-xs text-muted font-mono mt-1.5">
                  <Icon name={getIconForRole(item.id)} class="w-3.5 h-3.5" />
                  <span>{item.company}</span>
                </div>
              </div>
              
              <!-- Timestamp Header (Derecha en Desktop) -->
              <div class="shrink-0 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-border/50 bg-bg text-[0.6rem] font-mono text-accent uppercase tracking-wider">
                  <Icon name="lucide:clock" class="w-3 h-3" />
                  {item.period}
                </span>
              </div>
            </div>
            
            <!-- Detalles (Minimalista) -->
            <div class="relative font-mono text-sm sm:text-base text-muted/90 leading-relaxed">
              <span class="absolute left-0 top-px text-accent/50 select-none text-xs sm:text-sm">❯</span>
              <p class="pl-4 m-0">
                {item.description}
              </p>
            </div>
          </div>
          
        </div>
      ))}
    </div>
  </div>
</section>
