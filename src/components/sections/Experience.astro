---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section id="experience" class="min-h-[70vh] py-12 md:py-20 flex flex-col justify-center">
  <h2 class="text-4xl font-bold text-text tracking-tight">{t.experience.title}</h2>
  <p class="mt-6 text-base text-muted leading-relaxed">
    Section placeholder — experience
  </p>
</section>
