---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import avatarImg from "../assets/avatar/avatarSinFondo.png";

interface Props {
  lang: string;
  t: Record<string, any>;
}

const { lang, t } = Astro.props;
const otherLang = lang === "es" ? "en" : "es";

// Aria-labels del toggle de tema, traducidos según el idioma activo.
const themeLabels: Record<string, { dark: string; light: string }> = {
  es: { dark: "Cambiar a modo oscuro", light: "Cambiar a modo claro" },
  en: { dark: "Switch to dark mode", light: "Switch to light mode" },
};
const themeLabel = themeLabels[lang] ?? themeLabels.es;

const navItems = [
  { key: "about", icon: "lucide:user" },
  { key: "projects", icon: "lucide:code-2" },
  { key: "skills", icon: "lucide:monitor" },
  { key: "experience", icon: "lucide:clock-3" },
  { key: "contact", icon: "lucide:mail" },
] as const;
---

<!-- Sidebar card — sticky, reserves space, visually floating via parent padding -->
<aside
  class="sticky top-4 z-50 flex h-[calc(100dvh-2rem)] flex-col
         rounded-2xl bg-surface border border-border
         shadow-lg shadow-black/20 sidebar-glow"
>
  <!-- ─── Profile ─── -->
  <div class="flex flex-col items-center gap-4 px-6 pt-8 pb-5">
    <div
      class="relative p-1 rounded-2xl bg-linear-to-b from-accent/20 to-transparent"
    >
      <Image
        src={avatarImg}
        alt={t.hero.name}
        class="h-28 w-28 rounded-xl object-cover object-top ring-1 ring-border/50 bg-bg shadow-lg"
      />
    </div>
    <div class="text-center">
      <p class="text-base font-bold text-text leading-tight">
        {t.hero.name.split(" ").slice(0, 2).join(" ")}
      </p>
      <p class="section-label mt-1.5 text-[0.7rem] tracking-[0.15em] text-dim">
        Full-Stack Engineer
      </p>
    </div>
  </div>

  <div class="h-px bg-border/60 mx-6"></div>

  <!-- ─── Controls (lang + theme) ─── -->
  <div class="flex items-center justify-center gap-4 px-6 py-4">
    <!-- Language switch -->
    <a
      href={`/${otherLang}/`}
      class="flex items-center gap-2 text-sm font-mono font-medium uppercase tracking-wider
             text-muted transition-colors duration-200
             hover:text-accent"
    >
      <Icon name="lucide:languages" class="w-4.5 h-4.5 text-muted/80" />
      ES/EN
    </a>

    <!-- Vertical Divider -->
    <div class="w-px h-4.5 bg-border/60"></div>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      type="button"
      class="flex items-center justify-center w-8 h-8 rounded-full
             text-muted transition-colors duration-200
             hover:text-accent hover:bg-hover"
      aria-label={themeLabel.dark}
      data-label-dark={themeLabel.dark}
      data-label-light={themeLabel.light}
    >
      <span id="theme-icon" class="text-base leading-none">🌙</span>
    </button>
  </div>

  <div class="h-px bg-border/60 mx-6"></div>

  <!-- ─── Navigation ─── -->
  <!-- min-h-0 es imprescindible: sin él un flex child no baja de su altura
         mínima y el overflow-y-auto no se aplica. Sin scroll, en pantallas
         bajas (móvil en horizontal) la nav se recortaba sin salida. -->
  <nav class="flex-1 min-h-0 overflow-y-auto overscroll-contain flex flex-col gap-1.5 px-3 py-5">
    {
      navItems.map(({ key, icon }) => (
        <a href={`#${key}`} data-section={key} class="nav-link">
          <Icon
            name={icon}
            class="w-5 h-5 shrink-0 text-muted group-hover:text-accent"
          />
          {t.nav[key]}
        </a>
      ))
    }
  </nav>
</aside>

<script>
  // --- Theme Toggle ---
  function initTheme() {
    const btn = document.getElementById("theme-toggle");
    const icon = document.getElementById("theme-icon");
    if (!btn || !icon) return;

    const update = () => {
      const isDark = document.documentElement.classList.contains("dark");
      icon.textContent = isDark ? "🌙" : "☀️";

      // El aria-label anuncia la acción disponible (ir al modo contrario).
      const nextLabel = isDark ? btn.dataset.labelLight : btn.dataset.labelDark;
      if (nextLabel) btn.setAttribute("aria-label", nextLabel);
    };

    update();

    btn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      update();
    });
  }

  initTheme();
  document.addEventListener("astro:after-swap", initTheme);

  // --- Scroll Spy & Breadcrumb Update ---
  function initScrollSpy() {
    const sections = document.querySelectorAll("section[id]");
    const links = document.querySelectorAll("[data-section]");
    const breadcrumbText = document.getElementById("breadcrumb-text");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            const el = link as HTMLElement;
            const isActive = el.dataset.section === entry.target.id;
            el.classList.toggle("active", isActive);

            if (isActive) {
              // Get clean translated name of the active section
              const sectionName = el.innerText || el.textContent || "";
              if (breadcrumbText) {
                breadcrumbText.textContent = `PORTFOLIO OS - ${sectionName.trim().toUpperCase()}`;
              }
            }
          });
        });
      },
      {
        threshold: 0,
        rootMargin: "-30% 0px -60% 0px",
      },
    );

    sections.forEach((s) => observer.observe(s));
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
