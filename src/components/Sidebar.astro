---
import { Icon } from 'astro-icon/components';

interface Props {
  lang: string;
  t: Record<string, any>;
}

const { lang, t } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';

const navOrder = ['about', 'projects', 'skills', 'experience', 'contact'] as const;
---

<aside
  class="fixed left-0 top-0 z-50 flex h-screen w-56 flex-col
         bg-surface border-r border-border"
>
  <!-- UPPER — Profile -->
  <div class="flex flex-col items-center gap-2 px-4 pt-8 pb-4">
    <img
      src="/avatar.jpg"
      alt={t.hero.name}
      class="h-20 w-20 rounded-full object-cover ring-2 ring-accent/40"
    />
    <p class="text-center text-sm font-bold text-text">
      {t.hero.name}
    </p>
    <p class="section-label text-center">
      Full-Stack Developer
    </p>
  </div>

  <!-- MIDDLE — Controls -->
  <div class="flex flex-col gap-2 border-t border-border px-4 py-3">
    <!-- Language switch -->
    <a
      href={`/${otherLang}/`}
      class="flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5
             text-xs font-medium text-muted transition-all duration-200
             hover:bg-hover hover:text-text"
    >
      <Icon name="lucide:globe" class="w-3.5 h-3.5" />
      {t.langSwitcher}
    </a>

    <!-- Separator -->
    <div class="h-px bg-border"></div>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      type="button"
      class="flex items-center justify-center gap-1.5 rounded-md px-3 py-1.5
             text-xs font-medium text-muted transition-all duration-200
             hover:bg-hover hover:text-text"
      aria-label="Toggle theme"
    >
      <span id="theme-icon" class="text-sm">🌙</span>
    </button>
  </div>

  <!-- MAIN — Navigation -->
  <nav class="flex-1 overflow-y-auto border-t border-border px-3 py-4">
    <ul class="flex flex-col gap-1">
      {navOrder.map((key) => (
        <li>
          <a
            href={`#${key}`}
            data-section={key}
            class="nav-link"
          >
            <Icon
              name="lucide:chevron-right"
              class="w-3 h-3 text-accent opacity-0 nav-indicator transition-opacity duration-200"
            />
            {t.nav[key]}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- BOTTOM — Location -->
  <div class="border-t border-border px-4 py-4">
    <p class="flex items-center gap-1.5 text-xs text-dim">
      <Icon name="lucide:map-pin" class="w-3 h-3 text-accent" />
      Cochabamba, Bolivia
    </p>
  </div>
</aside>

<script>
  // --- Theme Toggle ---
  function initTheme() {
    const btn = document.getElementById('theme-toggle');
    const icon = document.getElementById('theme-icon');
    if (!btn || !icon) return;

    const update = () => {
      const isDark = document.documentElement.classList.contains('dark');
      icon.textContent = isDark ? '🌙' : '☀️';
      btn.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    };

    update();

    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      update();
    });
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);

  // --- Scroll Spy ---
  function initScrollSpy() {
    const sections = document.querySelectorAll('section[id]');
    const links = document.querySelectorAll('[data-section]');

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        links.forEach(link => {
          const isActive = (link as HTMLElement).dataset.section === entry.target.id;
          link.classList.toggle('active', isActive);
          const indicator = link.querySelector('.nav-indicator');
          if (indicator) {
            indicator.classList.toggle('opacity-0', !isActive);
            indicator.classList.toggle('opacity-100', isActive);
          }
        });
      });
    }, { threshold: 0.4 });

    sections.forEach(s => observer.observe(s));
  }

  initScrollSpy();
  document.addEventListener('astro:after-swap', initScrollSpy);
</script>
