---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  lang: string;
  t: Record<string, any>;
}

const { lang, t } = Astro.props;
---

<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.hero.bio} />
    <title>{t.hero.name} — Portfolio</title>

    <!-- hreflang SEO -->
    <link rel="alternate" hreflang="es" href="https://pedromarquez.dev/es/" />
    <link rel="alternate" hreflang="en" href="https://pedromarquez.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://pedromarquez.dev/es/" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prevent theme flash: read localStorage BEFORE paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>

  <body>
    <div class="flex">
      <!-- Sidebar — fixed, does not scroll -->
      <Sidebar lang={lang} t={t} />

      <!-- Main — scrollable content area offset by sidebar width -->
      <main class="ml-56 min-h-screen flex-1 overflow-y-auto">
        <slot />
      </main>
    </div>
  </body>
</html>