---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: string;
  t: Record<string, any>;
}

const { lang, t } = Astro.props;
---

<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.hero.bio} />
    <title>{t.hero.name} — Portfolio</title>

    <!-- hreflang SEO -->
    <link rel="alternate" hreflang="es" href="https://pedromarquez.dev/es/" />
    <link rel="alternate" hreflang="en" href="https://pedromarquez.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://pedromarquez.dev/es/" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prevent theme flash: read localStorage BEFORE paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>

  <body>
    <!-- Drawer Backdrop (mobile only) -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 z-40 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none
             transition-opacity duration-300 lg:hidden"
    ></div>

    <!-- El frame usa unidades dinámicas de viewport (dvh) en lugar de las
         clásicas: con el viewport "large" el documento queda scrolleable por
         la diferencia con la barra de URL, y el navbar se sale de pantalla. -->
    <div class="flex h-dvh overflow-hidden">
      <!-- Sidebar container — Drawer on mobile, Sticky on desktop -->
      <div
        id="sidebar-wrapper"
        class="fixed inset-y-0 left-0 z-50 w-76 p-4 -translate-x-full transition-transform duration-300
               lg:translate-x-0 lg:sticky lg:top-0 lg:h-dvh lg:shrink-0 lg:p-4 lg:w-80"
      >
        <Sidebar lang={lang} t={t} />
      </div>

      <!-- Main content column — flex container spanning full height -->
      <main class="flex-1 flex flex-col h-dvh min-w-0 overflow-hidden">

        <!-- Header / Breadcrumb — outside scroll, always visible at the top -->
        <div class="shrink-0 w-full">
          <div class="max-w-7xl mx-auto px-4 md:px-6">
            <header class="flex items-center justify-between w-full pt-8 pb-5 font-mono text-xs text-muted">
              <div class="flex items-center gap-2.5">
                <!-- Mobile Menu button -->
                <button
                  id="menu-toggle"
                  class="lg:hidden p-1 -ml-1 text-muted hover:text-text hover:bg-hover rounded transition-colors duration-200"
                  aria-label="Toggle menu"
                  aria-expanded="false"
                  aria-controls="sidebar-wrapper"
                >
                  <Icon name="lucide:menu" class="w-5 h-5" />
                </button>
                <Icon name="lucide:terminal" class="w-4 h-4 text-accent" />
                <span id="breadcrumb-text">PORTFOLIO OS - {t.nav.about.toUpperCase()}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-dim font-bold">V1.0.0</span>
              </div>
            </header>
          </div>
        </div>

        <!-- Único scroller de la app. `scroll-smooth` vive aquí (y no en `html`)
             para que la animación no se propague al raíz. `overscroll-contain`
             evita que el momentum táctil se encadene hacia arriba. -->
        <div id="content-scroll" class="flex-1 overflow-y-auto overscroll-contain scroll-smooth w-full">
          <div class="max-w-7xl mx-auto px-4 md:px-6 pb-12">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <!-- Client-side drawer behavior -->
    <script>
      function initDrawer() {
        const menuToggle = document.getElementById('menu-toggle');
        const sidebarWrapper = document.getElementById('sidebar-wrapper');
        const backdrop = document.getElementById('sidebar-backdrop');
        const navLinks = document.querySelectorAll('.nav-link');

        if (!menuToggle || !sidebarWrapper || !backdrop) return;

        // El drawer solo existe por debajo de `lg`: allí el botón tiene layout,
        // en desktop está oculto con `lg:hidden` y el sidebar es sticky.
        const isDrawerMode = () => menuToggle.offsetParent !== null;

        const setDrawer = (open: boolean) => {
          sidebarWrapper.classList.toggle('-translate-x-full', !open);
          backdrop.classList.toggle('opacity-100', open);
          backdrop.classList.toggle('pointer-events-auto', open);
          backdrop.classList.toggle('opacity-0', !open);
          backdrop.classList.toggle('pointer-events-none', !open);
          menuToggle.setAttribute('aria-expanded', String(open));
        };

        const isOpen = () => !sidebarWrapper.classList.contains('-translate-x-full');

        setDrawer(false);

        menuToggle.addEventListener('click', () => setDrawer(!isOpen()));
        backdrop.addEventListener('click', () => setDrawer(false));
        navLinks.forEach((link) => link.addEventListener('click', () => setDrawer(false)));

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isDrawerMode() && isOpen()) setDrawer(false);
        });
      }

      initDrawer();
      document.addEventListener('astro:after-swap', initDrawer);
    </script>
  </body>
</html>